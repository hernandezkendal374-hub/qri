# PostgreSQL is the production target. SQLite is supported for local POC/tests.
DATABASE_URL=postgresql+psycopg://qri:qri@localhost:5432/qri
# Any OpenAI-compatible endpoint. The model ids below are only a starting
# point -- use whatever your gateway exposes.
LLM_BASE_URL=
LLM_API_KEY=
PRIMARY_MODEL=claude-sonnet-5
REASONING_MODEL=claude-sonnet-5
# Generates Research Validation Specs; it must not generate trading strategies.
VALIDATION_MODEL=claude-sonnet-5
SCOUT_SCORE_THRESHOLD=0.48
SCOUT_MAX_ITEMS=30
DEEP_RESEARCH_THRESHOLD=0.62
DEEP_RESEARCH_MAX_ITEMS=5
DAILY_SCAN_TARGET=300
COMMUNITY_SHADOW_ENABLED=true
# Optional Stack Exchange API key; the official API also works without one.
STACKEXCHANGE_API_KEY=
# Optional cost accounting for the AI call audit trail, per million tokens.
# QRI ships no vendor price table; set these to match your own gateway.
INPUT_COST_PER_MILLION_TOKENS=0
OUTPUT_COST_PER_MILLION_TOKENS=0
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
QRI_LOG_LEVEL=INFO
